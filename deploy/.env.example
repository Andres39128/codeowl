# =============================================================================
# codeowl — variables de entorno documentadas
# Checklist F0: ".env.example completo y documentado" (guía §6).
# Referencias: mapa backend.config (validación por etapas), guía §3.3/§3.4
# (defaults materializados), §9.2 (secretos y variantes _FILE), §9.6 (topes).
#
# Uso en desarrollo:  cp deploy/.env.example .env   (en la raíz del repo)
#   - el justfile exporta .env automáticamente (set dotenv-load)
#   - deploy/compose.dev.yml lo inyecta al contenedor de Postgres (env_file)
# Uso en self-host:   copiar a ~/opt/codeowl/env (chmod 600) — ver deploy/quadlet/
#
# Convención de secretos (§9.2): cada secreto admite valor directo o ruta
# _FILE; en Quadlet se usa SIEMPRE la variante _FILE (credencial montada —
# systemctl show jamás expone el valor). Un _FILE vacío equivale a no seteado.
# Las variables de features que aterrizan en fases posteriores se marcan (Fn)
# y se declaran igual desde F0.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres — imagen docker.io/pgvector/pgvector:pg18 (mapa servicios.postgres)
# -----------------------------------------------------------------------------
# Usuario y nombre de la BD del server; DATABASE_URL (abajo) debe ser consistente.
POSTGRES_USER=codeowl
POSTGRES_DB=codeowl
# Password del server de Postgres. En self-host NO va por Environment= (§9.2):
# la unidad postgres monta el archivo de credencial y fija POSTGRES_PASSWORD_FILE
# por su cuenta — dejá esta variable vacía en el env de producción.
POSTGRES_PASSWORD=cambia-esto-en-cada-entorno
POSTGRES_PASSWORD_FILE=
# Puerto de host del server en DESARROLLO (§4.2: los puertos son config;
# default 5432). Solo dev — en self-host Postgres no publica puertos (§3.5).
# Si lo cambiás, alineá el puerto de DATABASE_URL.
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Arranque esencial (F0) — mapa backend.config: fail-fast solo de DB, master
# key, escucha y sesión; las credenciales VCS validan al conectar el primer repo.
# -----------------------------------------------------------------------------
# Cadena de conexión de api y worker (pgx). En self-host lleva la password de
# Postgres: el archivo env completo queda chmod 600 y jamás entra a git.
# En desarrollo el puerto debe coincidir con POSTGRES_HOST_PORT.
DATABASE_URL=postgres://codeowl:cambia-esto-en-cada-entorno@localhost:5432/codeowl?sslmode=disable
# Dirección de escucha de la API (mapa servicios.api; default :8080 — Caddy
# proxyea 443 → 8080, §3.5).
API_ADDR=:8080
# Master key del cifrado en reposo AES-256-GCM (§9.2). Generar con:
#   openssl rand -base64 32
# Se respalda APARTE del dump — runbook en deploy/backup.md (§9.10).
MASTER_KEY=REEMPLAZAR:openssl-rand-base64-32
MASTER_KEY_FILE=
# Expiración de la sesión del dashboard (§3.4: token opaco en cookie HttpOnly;
# en BD solo el hash).
SESSION_TTL=24h
# Longitud mínima de contraseñas (§3.4: default 12 — OWASP Authentication
# Cheatsheet; overridable por env, materializada desde F0).
PASSWORD_MIN_LENGTH=12

# -----------------------------------------------------------------------------
# Seed del primer admin (F0 — guía §3.4): el primer arranque crea este usuario
# con role admin. La variante _FILE es la que usa la unidad api en Quadlet
# (§3.4 + §9.2).
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto-en-cada-entorno
ADMIN_PASSWORD_FILE=

# -----------------------------------------------------------------------------
# GitHub App (F1 — mapa backend.config: se validan al conectar el primer repo
# GitHub; F0 corre sin credenciales VCS). Secret y private key son globales de
# la App, no por repo (§3.3). La private key vive en las unidades api y worker
# (§9.2); el webhook secret, solo en api.
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET_FILE=

# -----------------------------------------------------------------------------
# Rotación de la master key (F1 — §9.2): durante la rotación conviven la nueva
# (MASTER_KEY) y la vieja (MASTER_KEY_PREVIOUS) en las unidades api y worker;
# recién entonces corre el RotationJob y al terminar se retira _PREVIOUS.
# -----------------------------------------------------------------------------
MASTER_KEY_PREVIOUS=
MASTER_KEY_PREVIOUS_FILE=

# -----------------------------------------------------------------------------
# Topes de pipeline (F1 — la guía manda materializarlos en .env.example desde F0)
# -----------------------------------------------------------------------------
# Presupuesto de disco por workdir de job (§3.3: default 2 GiB — cubre el clon
# shallow y los artefactos de compilación de los linters).
WORKDIR_DISK_BUDGET=2GiB
# Tope de líneas cambiadas del diff por encima del cual el PR recibe solo
# resumen y la corrida queda partial (§9.6: default 4000).
DIFF_MAX_LINES=4000
# Tope análogo por archivo: el archivo que lo excede se procesa solo con
# SAST y la corrida queda partial (§9.6: default 1000).
DIFF_FILE_MAX_LINES=1000
# Tope de tamaño del payload de webhook: se rechaza antes de parsear (§9.3).
# Default 25MiB — el tope con el que GitHub deja de entregar.
WEBHOOK_MAX_BYTES=25MiB
# Timeout por llamada HTTP a la API del VCS (default 30s).
VCS_TIMEOUT=30s
# Llamadas LLM simultáneas por review (§9.6: default 4).
LLM_MAX_PER_REVIEW=4
# Llamadas LLM simultáneas globales del gateway (§9.6: default 8) — una
# ráfaga de PRs simultáneos no dispara rate limits del proveedor.
LLM_MAX_GLOBAL=8
# Timeout por llamada LLM, por intento HTTP (§9.7: default 120s).
LLM_TIMEOUT=120s
# Reintentos por proveedor ante 429/5xx antes de conmutar al siguiente
# proveedor enabled del rol (§9.7: default 3).
LLM_MAX_RETRIES=3

# --- Embeddings (F4, §6/§9.6, internal/llm) ---
# Máximo de textos por llamada a /v1/embeddings del rol embedding: Embed
# parte el lote en chunks de este tamaño y concatena los resultados en
# orden (default 64).
EMBED_BATCH_SIZE=64

# --- Indexación (F4, §6/§9.6, internal/index) ---
# Tope de símbolos embebidos por IndexJob: agotado el presupuesto, la
# indexación queda PARCIAL y el próximo job la retoma por file_hash
# (resume, §9.6 — default 2000).
INDEX_MAX_SYMBOLS_PER_RUN=2000

# K del top-K coseno del retrieval del Reviewer (F4, §6): símbolos
# relacionados por archivo revisado, antes de la expansión de 1 salto por el
# grafo de imports (default 8).
RETRIEVAL_TOP_K=8

# Tope de caracteres del bloque "Símbolos relacionados" que el Reviewer
# recibe después del diff (F4, §6): se recortan entradas completas, nunca a
# mitad de línea, y la omisión queda declarada al pie (default 4000,
# mínimo 500). Un fallo del índice NUNCA degrada la revisión (§9.6).
REVIEW_CONTEXT_MAX_CHARS=4000

# --- Pipeline de review (§3.6/§9.6/§9.8, internal/review) ---
# Reintentos por salida malformada del agente antes de descartar el archivo
# (§9.8: default 2).
REVIEW_AGENT_RETRIES=2
# Tolerancia de drift del ancla de dedup: un push que corra líneas no
# republica el mismo hallazgo (§3.6.3: ±3 líneas, default 3).
REVIEW_DRIFT_LINES=3
# Perfil de revisión global para repos sin review.yaml (§9.5:
# chill | assertive | strict — el review.yaml de la rama base pisa este
# default por clave).
REVIEW_DEFAULT_PROFILE=assertive
# Cache de resultados en memoria del worker: TTL y tope de entradas (§9.6).
# Un miss solo recomputa; se pierde al reiniciar (single worker por diseño).
REVIEW_CACHE_TTL=1h
REVIEW_CACHE_MAX_ENTRIES=100

# --- Risk scoring (F5, §6, internal/review) ---
# Patrones glob (mismo estilo que los path_filters de review.yaml, separados
# por comas) de archivos sensibles que suman al risk score del PR: un proxy
# 0-100 computable que ORDENA el triage del dashboard — no es veredicto
# bloqueante (guía §1.1). Defaults: auth, secretos/credenciales, migraciones,
# CI/workflows y deploy. NO setearla cae en estos defaults; setearla VACÍA
# desactiva solo el bonus de sensibles (el resto de la fórmula sigue).
RISK_SENSITIVE_PATHS=auth/**,*secret*,**/credentials*,**/migrations/**,.github/workflows/**,.gitlab-ci.yml,deploy/**

# --- Analyzer sandbox (§9.4, internal/analyze) ---
# Imagen del sandbox y topes de ejecución: sin red, rootfs read-only.
ANALYZER_IMAGE=localhost/codeowl-analyzer:latest
ANALYZER_MEMORY=1g
ANALYZER_PIDS_LIMIT=256
ANALYZER_TIMEOUT=120s
ANALYZER_TMPFS_SIZE=512m

# --- Jobs del worker (§9.6/§9.11, internal/jobs) ---
# ReviewJobs concurrentes en el worker: dimensiona el SLO de §6 junto con los
# topes del gateway (§9.6: default 2).
REVIEW_CONCURRENCY=2
# Slots propios del ChatJob (F2): su SLO de respuesta no espera detrás de
# reviews largas (§9.6: default 2).
CHAT_CONCURRENCY=2
# Retención del CleanupJob para webhook_deliveries en días (§9.11: default
# 30) — acota la ventana de cálculo del P95 de §6.
CLEANUP_RETENTION_DAYS=30

# --- GitLab (§9.3/§3.5/§3.6.1.1, internal/vcs/gitlab) ---
# Username del bot GitLab: el anti-bucle del chat compara contra él — GitLab
# no expone flag de autor bot en note (§3.5: default codeowl).
GITLAB_BOT_USERNAME=codeowl
# Tolerancia de frescura del timestamp Standard Webhooks contra replay (§9.3:
# default 5m, el default del SDK).
WEBHOOK_TIMESTAMP_TOLERANCE=5m
# TTL de la cache del tip de la rama base: el payload GitLab no trae el SHA
# de la base y se resuelve por API con cache corto (§3.6.1.1: default 30s).
BRANCH_TIP_CACHE_TTL=30s

# --- Chat (F2, §3.5/§9.6, internal/vcs + internal/review) ---
# Username del bot en GitHub para las menciones del chat (§3.5: default
# codeowl-bot — alinealo al slug de tu GitHub App si difiere).
GITHUB_BOT_USERNAME=codeowl-bot
# Tope de líneas de diff que entran al prompt del chat (§9.6: presupuesto
# propio del chat — default 5000).
CHAT_DIFF_MAX_LINES=5000
# Tope de pruebas unitarias que genera el comando /tests (§9.6: presupuesto
# LLM propio del comando — default 3).
CHAT_TEST_MAX_SNIPPETS=3
